# Copy this to .env and fill in real values. Never commit .env to git.

NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/smart-energy

# JWT secret — use a random 64-character hex string in production
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING_BEFORE_RUNNING

# Frontend origin for CORS (comma-separated if multiple)
CORS_ORIGIN=http://localhost:5173

# Set to true to enable the hourly simulator ticker
SIMULATOR_ENABLED=false

# Admin account created by: npm run seed:admin
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@demo.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
